# RunPod API key (Settings -> API Keys in the RunPod console)
RUNPOD_API_KEY=

# Qwen serverless endpoint
RUNPOD_QWEN_ENDPOINT_ID=
# Must match the model name the vLLM worker was deployed with, e.g. Qwen/Qwen2.5-7B-Instruct
RUNPOD_QWEN_MODEL=

# Llama serverless endpoint
RUNPOD_LLAMA_ENDPOINT_ID=
# Must match the model name the vLLM worker was deployed with, e.g. meta-llama/Llama-3.1-8B-Instruct
RUNPOD_LLAMA_MODEL=
